{
  "name": "clocked-return-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "capture:qa": "node ./scripts/capture-release-assets.mjs",
    "smoke": "node ./scripts/regression-browser.mjs",
    "redteam": "node ./scripts/redteam-p0.mjs",
    "redteam:mutation": "node ./scripts/redteam-metamorphic.mjs",
    "ui:audit": "node ./scripts/ui-audit.mjs",
    "security:audit": "node ./scripts/security-audit-ui-release.mjs",
    "redteam:ui": "node ./scripts/redteam-ui-release.mjs",
    "redteam:heldout": "node ./scripts/redteam-heldout-round4.mjs"
  },
  "dependencies": {
    "clocked-sdk": "0.7.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
