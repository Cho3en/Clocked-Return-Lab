# Copy to .env.local; never commit or share its values.

# Clocked service key stays on the server.
CLOCKED_API_KEY=

# Separate random 32+ character password required for access to LIVE analysis.
# Generate locally: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
RETURNLAB_ACCESS_TOKEN=

# Live mode stays off unless every value below is present and explicit.
# The application cannot verify the upstream account limits; these are operator
# attestations, and the app refuses live calls without them.
RETURNLAB_LIVE_ENABLED=NO
CLOCKED_ROTATED_KEY_CONFIRMED=NO
CLOCKED_PROVIDER_HARD_CAP_CONFIRMED=NO
# Highest accepted value is 0.05 USD.
CLOCKED_PROVIDER_HARD_CAP_USD=0.05
